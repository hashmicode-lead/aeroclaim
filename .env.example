# Copy to .env.local for local overrides. Leave everything empty to use ./data locally.

# Turso (libSQL) database. Set automatically by the Turso integration on Vercel.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob (private store). Set automatically when you connect a Blob store on Vercel.
BLOB_READ_WRITE_TOKEN=
